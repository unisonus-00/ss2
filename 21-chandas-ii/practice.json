          "type": "choice",
          "front": "How many pādas make one anuṣṭubh?",
          "options": [
            "4",
            "2",
            "8"
          ],
          "answer": "4",
          "note": "four pādas of eight syllables — 32 in all, two pādas to a half-verse",
          "source": "theory · The Rules"
        },
        {
          "id": "21-chandas-ii:anustubh:syllables",
          "type": "choice",
          "front": "How many syllables does one anuṣṭubh pāda hold?",
          "options": [
            "8",
            "11",
            "16"
          ],
          "answer": "8",
          "note": "the count is fixed; the weights are only constrained at 5–6–7",
          "source": "theory · The Rules"
        },
        {
          "id": "21-chandas-ii:anustubh:pada-b",
          "type": "choice",
          "front": "In pāda b, syllables 5–6–7 are:",
          "options": [
            "∪ – –",
            "∪ – ∪",
            "– ∪ –"
          ],
          "answer": "∪ – –",
          "note": "the even pādas carry the constraint — pāda b closes ∪ – –",
          "source": "theory · The Rules"
        },
        {
          "id": "21-chandas-ii:anustubh:pada-d",
          "type": "choice",
          "front": "In pāda d, syllables 5–6–7 are:",
          "options": [
            "∪ – ∪",
            "∪ – –",
            "– – ∪"
          ],
          "answer": "∪ – ∪",
          "note": "pāda d differs from pāda b only in the seventh syllable",
          "source": "theory · The Rules"
        },
        {
          "id": "21-chandas-ii:anustubh:odd-padas",
          "type": "choice",
          "front": "Which pattern is avoided at 5–6–7 of an odd pāda?",
          "options": [
            "∪ – ∪",
            "∪ – –",
            "– ∪ ∪"
          ],
          "answer": "∪ – ∪",
          "note": "ja-gaṇa is avoided in pādas a and c; otherwise the odd pādas are free",
          "source": "theory · The Rules"
        },
        {
          "id": "21-chandas-ii:anustubh:yati",
          "type": "choice",
          "front": "Where does the yati normally fall in a pāda?",
          "options": [
            "after the 4th syllable",
            "after the 5th syllable",
            "at the end only"
          ],
          "answer": "after the 4th syllable",
          "note": "a natural word-break halfway through the pāda",
          "source": "theory · The Rules"
