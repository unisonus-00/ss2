            "rāmāya",
            "rāmasya"
          ],
          "answer": "rāmam",
          "note": "dvitīyā · namāmi takes an object, unlike namaḥ",
          "source": "workbook C2"
        },
        {
          "id": "05-rupa:phrase:puspena-pujayami",
          "type": "choice",
          "front": "___ pūjayāmi — “I worship with a flower”",
          "options": [
            "puṣpeṇa",
            "puṣpam",
            "puṣpāya"
          ],
          "answer": "puṣpeṇa",
          "note": "tṛtīyā · the instrument of the worship",
          "source": "workbook C2"
        },
        {
          "id": "05-rupa:phrase:krsne-bhaktih",
          "type": "choice",
          "front": "___ bhaktiḥ — “devotion in Kṛṣṇa”",
          "options": [
            "kṛṣṇe",
            "kṛṣṇasya",
            "kṛṣṇāya"
          ],
          "answer": "kṛṣṇe",
          "note": "saptamī · devotion rests *in* its object",
          "source": "workbook C2"
        }
      ]
    },
