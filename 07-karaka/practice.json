        {
          "id": "07-karaka:role:bhaktah",
          "type": "choice",
          "front": "Role of bhaktaḥ:\nbhaktaḥ devam pūjayati",
          "options": [
            "kartā",
            "karma",
            "karaṇa"
          ],
          "answer": "kartā",
          "note": "kartā · agent · prathamā · nom. sg.",
          "source": "workbook A1"
        },
        {
          "id": "07-karaka:role:devam",
          "type": "choice",
          "front": "Role of devam:\nbhaktaḥ devam pūjayati",
          "options": [
            "karma",
            "kartā",
            "sampradāna"
          ],
          "answer": "karma",
          "note": "karma · object · dvitīyā · acc. sg.",
          "source": "workbook A1"
        },
        {
          "id": "07-karaka:role:puspena",
          "type": "choice",
          "front": "Role of puṣpeṇa:\nbhaktaḥ puṣpeṇa devam pūjayati",
          "options": [
            "karaṇa",
            "kartā",
            "karma"
          ],
          "answer": "karaṇa",
          "note": "karaṇa · instrument · tṛtīyā · instr. sg.",
          "source": "workbook A1"
        },
        {
          "id": "07-karaka:role:sivaya",
          "type": "choice",
          "front": "Role of śivāya:\nbhaktaḥ śivāya namaḥ karoti",
          "options": [
            "sampradāna",
            "adhikaraṇa",
            "karaṇa"
          ],
          "answer": "sampradāna",
          "note": "sampradāna · recipient · caturthī · dat. sg.",
          "source": "workbook A1"
        },
        {
          "id": "07-karaka:role:mandire",
          "type": "choice",
          "front": "Role of mandire:\nbhaktaḥ mandire pūjayati",
          "options": [
            "adhikaraṇa",
            "apādāna",
            "karaṇa"
          ],
          "answer": "adhikaraṇa",
          "note": "adhikaraṇa · location · saptamī · loc. sg.",
          "source": "workbook A1"
        },
        {
          "id": "07-karaka:role:bhaktya",
          "type": "choice",
          "front": "Role of bhaktyā:\nbhaktaḥ bhaktyā devāya puṣpam arpayati",
          "options": [
            "karaṇa",
            "sampradāna",
            "kartā"
          ],
          "answer": "karaṇa",
          "note": "karaṇa · instrument — “with devotion” · tṛtīyā",
          "source": "workbook B1"
        },
        {
          "id": "07-karaka:role:devaya-arpayati",
          "type": "choice",
          "front": "Role of devāya:\nbhaktaḥ bhaktyā devāya puṣpam arpayati",
          "options": [
            "sampradāna",
            "karma",
            "adhikaraṇa"
          ],
          "answer": "sampradāna",
          "note": "sampradāna · recipient — to whom it is offered · caturthī",
          "source": "workbook B1"
        },
        {
          "id": "07-karaka:case:karana",
          "type": "choice",
          "front": "Which vibhakti carries karaṇa?",
          "options": [
            "tṛtīyā",
            "dvitīyā",
            "caturthī"
          ],
          "answer": "tṛtīyā",
          "note": "instrument · 3rd",
          "source": "workbook A2"
        },
        {
          "id": "07-karaka:case:sampradana",
          "type": "choice",
          "front": "Which vibhakti carries sampradāna?",
          "options": [
            "caturthī",
            "tṛtīyā",
            "ṣaṣṭhī"
          ],
          "answer": "caturthī",
          "note": "recipient · 4th",
          "source": "workbook A2"
        },
        {
          "id": "07-karaka:case:apadana",
          "type": "choice",
          "front": "Which vibhakti carries apādāna?",
          "options": [
            "pañcamī",
            "saptamī",
            "tṛtīyā"
          ],
          "answer": "pañcamī",
          "note": "source · 5th",
          "source": "workbook A2"
        },
        {
          "id": "07-karaka:case:not-a-karaka",
          "type": "choice",
          "front": "Which vibhakti is NOT a kāraka?",
          "options": [
            "ṣaṣṭhī",
            "tṛtīyā",
            "saptamī"
          ],
          "answer": "ṣaṣṭhī",
          "note": "ṣaṣṭhī expresses sambandha — relation, not participation in the action",
          "source": "workbook A3"
        }
      ]
    },
