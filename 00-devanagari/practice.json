    {
      "name": "Mātrā-viśeṣa — signs out of place · practice",
      "stream": "script",
      "cards": [
        {
          "id": "00-devanagari:matra-special:before",
          "type": "choice",
          "front": "Which vowel sign is written before its consonant and read after it?",
          "options": [
            "the i sign, as in कि",
            "the ī sign, as in की",
            "the u sign, as in कु",
            "the e sign, as in के"
          ],
          "answer": "the i sign, as in कि",
          "note": "the page and the sound part company here, and nowhere else among the signs",
          "source": "workbook D1"
        },
        {
          "id": "00-devanagari:matra-special:hr",
          "type": "choice",
          "front": "Read it: हृ",
          "options": [
            "hṛ",
            "hu",
            "hū",
            "he"
          ],
          "answer": "hṛ",
          "note": "ह takes the ṛ sign in a place of its own — हृदयम् opens with it",
          "source": "workbook D2"
        },
        {
          "id": "00-devanagari:matra-special:ru",
          "type": "choice",
          "front": "Read it: रु",
          "options": [
            "ru",
            "rū",
            "rṛ",
            "ra"
          ],
          "answer": "ru",
          "note": "र carries u in a shape of its own rather than the ordinary sign",
          "source": "workbook D3"
        },
        {
          "id": "00-devanagari:matra-special:ruu",
          "type": "choice",
          "front": "Read it: रू",
          "options": [
            "rū",
            "ru",
            "rī",
            "rau"
          ],
          "answer": "rū",
          "note": "and ū likewise — the pair रु / रू is worth learning together",
          "source": "workbook D4"
        },
        {
          "id": "00-devanagari:matra-special:kim",
          "type": "choice",
          "front": "Read it: किम्",
          "options": [
            "kim",
            "kīm",
            "ikam",
            "kmi"
          ],
          "answer": "kim",
          "note": "the i sign stands to the left of क and is read after it; the virāma ends the word",
          "source": "workbook D5"
        },
        {
          "id": "00-devanagari:matra-special:nadi",
          "type": "choice",
          "front": "Read it: नदी",
          "options": [
            "nadī",
            "nadi",
            "ndī",
            "nādī"
          ],
          "answer": "nadī",
          "note": "the ī sign belongs to द, and nothing is written for the a on न",
          "source": "workbook D6"
        }
      ]
    },
    {
      "name": "Virāma — the built-in a and its cancelling · practice",
      "stream": "script",
      "cards": [
        {
          "id": "00-devanagari:virama:rule",
          "type": "choice",
          "front": "What does a virāma do to the letter it sits under?",
          "options": [
            "it takes away the a that letter would otherwise carry",
            "it puts a short a on a letter that had none",
            "it lengthens the vowel already there",
            "it marks the end of the sentence"
          ],
          "answer": "it takes away the a that letter would otherwise carry",
          "note": "nothing is written for the built-in a, so something has to be written to take it away",
          "source": "workbook B"
        },
        {
          "id": "00-devanagari:virama:bare-k",
          "type": "choice",
          "front": "Read it: क्",
          "options": [
            "k, with no vowel after it",
            "ka",
            "kā",
            "ki"
          ],
          "answer": "k, with no vowel after it",
          "note": "virāma · the stroke under the letter",
          "source": "workbook B1"
        },
        {
          "id": "00-devanagari:virama:nama",
          "type": "choice",
          "front": "Read it: नम",
          "options": [
            "nama",
            "nam",
            "nāma",
            "nma"
          ],
          "answer": "nama",
          "note": "no vowel sign and no virāma, so both letters keep their built-in a",
          "source": "workbook B2"
        },
        {
          "id": "00-devanagari:virama:namah-final",
          "type": "choice",
          "front": "Which of these ends in a bare consonant?",
          "options": [
            "नम्",
            "नम",
            "ना",
            "नि"
          ],
          "answer": "नम्",
          "note": "the virāma under the last letter is the only thing that stops it being ma",
          "source": "workbook B3"
        },
        {
          "id": "00-devanagari:virama:kara",
          "type": "choice",
          "front": "Read it: कर",
          "options": [
            "kara",
            "kra",
            "kar",
            "kāra"
          ],
          "answer": "kara",
          "note": "two letters, two built-in a’s, and nothing written for either",
          "source": "workbook B4"
        },
        {
          "id": "00-devanagari:virama:tat",
          "type": "choice",
          "front": "Read it: तत्",
          "options": [
            "tat",
            "tata",
            "tāt",
            "tta"
          ],
          "answer": "tat",
          "note": "one virāma, at the end; the first त keeps its a",
          "source": "workbook B5"
        },
        {
          "id": "00-devanagari:virama:vad",
          "type": "choice",
          "front": "Read it: वद्",
          "options": [
            "vad",
            "vada",
            "vād",
            "vd"
          ],
          "answer": "vad",
          "note": "the same contrast as नम / नम्, on a different pair of letters",
          "source": "workbook B6"
        },
        {
          "id": "00-devanagari:virama:vastram",
          "type": "choice",
          "front": "Read it: वस्त्रम्",
          "options": [
            "vastram",
            "vasatram",
            "vastaram",
            "vāstram"
          ],
          "answer": "vastram",
          "note": "स्त्र is three consonants with no vowel between them, and the page shows that by writing them as one",
          "source": "workbook B7"
        }
      ]
    },
    {
      "name": "Saṃyoga — splitting a conjunct · practice",
      "stream": "script",
      "cards": [
        {
          "id": "00-devanagari:conjunct-rule:how",
          "type": "choice",
          "front": "How is an ordinary conjunct built?",
          "options": [
            "the first letter loses its upright stroke and the next is joined on",
            "the two letters are written side by side, both unchanged",
            "a dot is placed above the first letter",
            "the second letter is written above the first"
          ],
          "answer": "the first letter loses its upright stroke and the next is joined on",
          "note": "a conjunct says one thing only: no vowel comes between these consonants",
          "source": "workbook F"
        },
        {
          "id": "00-devanagari:conjunct:nda",
          "type": "choice",
          "front": "Split it: ण्ड",
          "options": [
            "ṇ + ḍa",
            "ṇ + da",
            "na + ḍa",
            "ḍ + ṇa"
          ],
          "answer": "ṇ + ḍa",
          "note": "both letters are retroflex, and चण्डिका turns on hearing that",
          "source": "workbook F1"
        },
        {
          "id": "00-devanagari:conjunct:tma",
          "type": "choice",
          "front": "Split it: त्म",
          "options": [
            "t + ma",
            "t + ya",
            "m + ta",
            "th + ma"
          ],
          "answer": "t + ma",
          "note": "the ordinary rule: त gives up its upright stroke",
          "source": "workbook F2"
        },
        {
          "id": "00-devanagari:conjunct:tmya",
          "type": "choice",
          "front": "Split it: त्म्य",
          "options": [
            "t + m + ya",
            "t + mya",
            "th + m + ya",
            "m + t + ya"
          ],
          "answer": "t + m + ya",
          "note": "three consonants in one shape, and the rule is applied twice over",
          "source": "workbook F3"
        },
        {
          "id": "00-devanagari:conjunct:kka",
          "type": "choice",
          "front": "Split it: क्क",
          "options": [
            "k + ka",
            "k + kha",
            "ka + ga",
            "kh + ka"
          ],
          "answer": "k + ka",
          "note": "the same letter twice, which is not the same as one letter written large",
          "source": "workbook F4"
        },
        {
          "id": "00-devanagari:conjunct:dma",
          "type": "choice",
          "front": "Split it: द्म",
          "options": [
            "d + ma",
            "d + ya",
            "dh + ma",
            "m + da"
          ],
          "answer": "d + ma",
          "note": "द has no upright stroke to give up, so its partner hangs underneath",
          "source": "workbook F5"
        },
        {
          "id": "00-devanagari:conjunct:dbha",
          "type": "choice",
          "front": "Split it: द्भ",
          "options": [
            "d + bha",
            "dh + ba",
            "d + ba",
            "b + dha"
          ],
          "answer": "d + bha",
          "note": "stacked again — and the lower letter is भ, not ब",
          "source": "workbook F6"
        },
        {
          "id": "00-devanagari:conjunct:dya",
          "type": "choice",
          "front": "Split it: द्य",
          "options": [
            "d + ya",
            "dh + ya",
            "d + ma",
            "j + ya"
          ],
          "answer": "d + ya",
          "note": "नैवेद्यम् is read off this one",
          "source": "workbook F7"
        },
        {
          "id": "00-devanagari:conjunct:nna",
          "type": "choice",
          "front": "Split it: न्न",
          "options": [
            "n + na",
            "n + ta",
            "ṇ + na",
            "na + da"
          ],
          "answer": "n + na",
          "note": "न doubled, and neither of them retroflex",
          "source": "workbook F8"
        },
        {
          "id": "00-devanagari:conjunct:pta",
          "type": "choice",
          "front": "Split it: प्त",
          "options": [
            "p + ta",
            "p + tha",
            "pa + da",
            "t + pa"
          ],
          "answer": "p + ta",
          "note": "the ordinary rule once more",
          "source": "workbook F9"
        }
      ]
    },
    {
      "name": "Repha — r above the line and below it · practice",
      "stream": "script",
      "cards": [
        {
          "id": "00-devanagari:repha:arjuna",
          "type": "choice",
          "front": "What does the hook above ज say in अर्जुनः?",
          "options": [
            "an r sounded before ज",
            "an r sounded after ज",
            "a long vowel on ज",
            "an anusvāra"
          ],
          "answer": "an r sounded before ज",
          "note": "repha · र loses its own body and rides above whatever follows it",
          "source": "workbook H1"
        },
        {
          "id": "00-devanagari:rakara:cakra",
          "type": "choice",
          "front": "What does the stroke under क say in चक्र?",
          "options": [
            "an r sounded after क",
            "an r sounded before क",
            "a ṛ vowel on क",
            "that क has no vowel at all"
          ],
          "answer": "an r sounded after क",
          "note": "rakāra · the same letter र, hung underneath instead of above",
          "source": "workbook H2"
        },
        {
          "id": "00-devanagari:repha:karma",
          "type": "choice",
          "front": "Read it: कर्म",
          "options": [
            "karma",
            "krama",
            "kamra",
            "karama"
          ],
          "answer": "karma",
          "note": "the hook sits over म but is read before it",
          "source": "workbook H3"
        },
        {
          "id": "00-devanagari:repha:krama",
          "type": "choice",
          "front": "Read it: क्रम",
          "options": [
            "krama",
            "karma",
            "kamra",
            "kṛma"
          ],
          "answer": "krama",
          "note": "the same three consonants as कर्म, and only the position of र says which word it is",
          "source": "workbook H4"
        },
        {
          "id": "00-devanagari:repha:dharma",
          "type": "choice",
          "front": "Read it: धर्मः",
          "options": [
            "dharmaḥ",
            "dhramaḥ",
            "dhamraḥ",
            "dharamaḥ"
          ],
          "answer": "dharmaḥ",
          "note": "a repha over म, then a visarga",
          "source": "workbook H5"
        },
        {
          "id": "00-devanagari:repha:surya",
          "type": "choice",
          "front": "Read it: सूर्यः",
          "options": [
            "sūryaḥ",
            "sūyraḥ",
            "suryaḥ",
            "srūyaḥ"
          ],
          "answer": "sūryaḥ",
          "note": "the hook rides over य, so the r comes first",
          "source": "workbook H6"
        },
        {
          "id": "00-devanagari:repha:arghyam",
          "type": "choice",
          "front": "Read it: अर्घ्यम्",
          "options": [
            "arghyam",
            "aghryam",
            "argyham",
            "arghayam"
          ],
          "answer": "arghyam",
          "note": "a repha over घ्य, which is itself a conjunct",
          "source": "workbook H7"
        },
        {
          "id": "00-devanagari:repha:karpura",
          "type": "choice",
          "front": "Read it: कर्पूरः",
          "options": [
            "karpūraḥ",
            "krapūraḥ",
            "kapūraḥ",
            "karpuraḥ"
          ],
          "answer": "karpūraḥ",
          "note": "a repha over प, which also carries the ū sign",
          "source": "workbook H8"
        }
      ]
    },
    {
      "name": "Cihna — anusvāra, visarga and daṇḍa · practice",
      "stream": "script",
      "cards": [
        {
          "id": "00-devanagari:sign:anusvara",
          "type": "choice",
          "front": "What does a single dot above the line say?",
          "options": [
            "anusvāra — a nasal closing the syllable, written ṃ",
            "visarga — a light breath, written ḥ",
            "that the vowel under it is long",
            "that the word ends here"
          ],
          "answer": "anusvāra — a nasal closing the syllable, written ṃ",
          "note": "anusvāra · a sound, not punctuation",
          "source": "workbook I1"
        },
        {
          "id": "00-devanagari:sign:visarga",
          "type": "choice",
          "front": "What do two dots after a letter say?",
          "options": [
            "visarga — a light breath, written ḥ",
            "anusvāra — a nasal, written ṃ",
            "that the consonant is doubled",
            "that the letter has no vowel"
          ],
          "answer": "visarga — a light breath, written ḥ",
          "note": "visarga · it closes an enormous number of Sanskrit words — शिवः, गणेशः, नमः",
          "source": "workbook I2"
        },
        {
          "id": "00-devanagari:sign:anusvara-word",
          "type": "choice",
          "front": "Read it: हंसः",
          "options": [
            "haṃsaḥ",
            "hamasaḥ",
            "hasaḥ",
            "haṃsā"
          ],
          "answer": "haṃsaḥ",
          "note": "the dot is a sound of its own, so nothing is dropped and nothing is added",
          "source": "workbook I3"
        },
        {
          "id": "00-devanagari:sign:visarga-word",
          "type": "choice",
          "front": "Read it: नरः",
          "options": [
            "naraḥ",
            "naram",
            "narā",
            "nari"
          ],
          "answer": "naraḥ",
          "note": "two dots, not one, and not a bar",
          "source": "workbook I4"
        },
        {
          "id": "00-devanagari:sign:vamsha",
          "type": "choice",
          "front": "Read it: वंशः",
          "options": [
            "vaṃśaḥ",
            "vamśaḥ",
            "vaśaḥ",
            "vaṃsaḥ"
          ],
          "answer": "vaṃśaḥ",
          "note": "an anusvāra and a visarga in the same short word",
          "source": "workbook I5"
        },
        {
          "id": "00-devanagari:sign:samskrtam",
          "type": "choice",
          "front": "Read it: संस्कृतम्",
          "options": [
            "saṃskṛtam",
            "sanskṛtam",
            "saṃskrutam",
            "saṃsakṛtam"
          ],
          "answer": "saṃskṛtam",
          "note": "the dot is an anusvāra, so it is transliterated ṃ and not n",
          "source": "workbook I6"
        },
        {
          "id": "00-devanagari:punctuation:danda",
          "type": "choice",
          "front": "What is ।?",
          "options": [
            "daṇḍa — the end of a sentence in prose, or of a line in verse",
            "a virāma",
            "an anusvāra",
            "a long ā sign"
          ],
          "answer": "daṇḍa — the end of a sentence in prose, or of a line in verse",
          "note": "punctuation, and the only mark here that is not a sound",
          "source": "workbook I7"
        },
        {
          "id": "00-devanagari:punctuation:double-danda",
          "type": "choice",
          "front": "What is ॥?",
          "options": [
            "a double daṇḍa — it commonly closes a verse",
            "two virāmas",
            "a visarga",
            "a pause of two beats"
          ],
          "answer": "a double daṇḍa — it commonly closes a verse",
          "note": "you will meet it at the end of every śloka in the course",
          "source": "workbook I8"
        }
      ]
    },
