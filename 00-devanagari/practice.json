    {
      "name": "Antaḥstha-ūṣman — semivowels and sibilants",
      "role": "core",
      "stream": "script",
      "pair": "glyph → sound",
      "cards": [
        {
          "id": "00-devanagari:glyph:ya",
          "devanagari": "य",
          "gloss": "ya",
          "note": "semivowel · easily taken for थ"
        },
        {
          "id": "00-devanagari:glyph:ra",
          "devanagari": "र",
          "gloss": "ra",
          "note": "semivowel · the one letter that vanishes into a different shape inside a conjunct — see Repha"
        },
        {
          "id": "00-devanagari:glyph:la",
          "devanagari": "ल",
          "gloss": "la",
          "note": "semivowel"
        },
        {
          "id": "00-devanagari:glyph:va",
          "devanagari": "व",
          "gloss": "va",
          "note": "semivowel · easily taken for ब"
        },
        {
          "id": "00-devanagari:glyph:sha",
          "devanagari": "श",
          "gloss": "śa",
          "note": "sibilant · it takes shapes of its own in conjuncts — श्र, श्च, श्व"
        },
        {
          "id": "00-devanagari:glyph:ssa",
          "devanagari": "ष",
          "gloss": "ṣa",
          "note": "sibilant · the second element of क्ष"
        },
        {
          "id": "00-devanagari:glyph:sa",
          "devanagari": "स",
          "gloss": "sa",
          "note": "sibilant"
        },
        {
          "id": "00-devanagari:glyph:ha",
          "devanagari": "ह",
          "gloss": "ha",
          "note": "the aspirate · it hangs its conjunct partner underneath — ह्म, ह्य"
        }
      ]
    },
    {
      "name": "Mātrā — the vowel signs",
      "role": "core",
      "stream": "script",
      "pair": "glyph → sound",
      "cards": [
        {
          "id": "00-devanagari:matra:kaa",
          "devanagari": "का",
          "gloss": "kā",
          "note": "vowel sign · ā is a bar to the right of the letter"
        },
        {
          "id": "00-devanagari:matra:ki",
          "devanagari": "कि",
          "gloss": "ki",
          "note": "vowel sign · i is written to the LEFT of its consonant and read after it — the one place the page and the sound part company"
        },
        {
          "id": "00-devanagari:matra:kii",
          "devanagari": "की",
          "gloss": "kī",
          "note": "vowel sign · ī sits to the right, the mirror of the i sign"
        },
        {
          "id": "00-devanagari:matra:ku",
          "devanagari": "कु",
          "gloss": "ku",
          "note": "vowel sign · u is written below the letter"
        },
        {
          "id": "00-devanagari:matra:kuu",
          "devanagari": "कू",
          "gloss": "kū",
          "note": "vowel sign · ū is written below, and is not the u sign"
        },
        {
          "id": "00-devanagari:matra:kr",
          "devanagari": "कृ",
          "gloss": "kṛ",
          "note": "vowel sign · ṛ is written below — कृष्णः opens with it"
        },
        {
          "id": "00-devanagari:matra:krr",
          "devanagari": "कॄ",
          "gloss": "kṝ",
          "note": "vowel sign · the long ṛ, and rare"
        },
        {
          "id": "00-devanagari:matra:kl",
          "devanagari": "कॢ",
          "gloss": "kḷ",
          "note": "vowel sign · rarer still, and effectively confined to the root kḷp"
        },
        {
          "id": "00-devanagari:matra:ke",
          "devanagari": "के",
          "gloss": "ke",
          "note": "vowel sign · e is a stroke above the headline"
        },
        {
          "id": "00-devanagari:matra:kai",
          "devanagari": "कै",
          "gloss": "kai",
          "note": "vowel sign · ai is two strokes above"
        },
        {
          "id": "00-devanagari:matra:ko",
          "devanagari": "को",
          "gloss": "ko",
          "note": "vowel sign · o is the ā bar with one stroke above it"
        },
        {
          "id": "00-devanagari:matra:kau",
          "devanagari": "कौ",
          "gloss": "kau",
          "note": "vowel sign · au is the ā bar with two strokes above it"
        }
      ]
    },
    {
      "name": "Saṃyukta — conjuncts to know by sight",
      "role": "core",
      "stream": "script",
      "pair": "glyph → sound",
      "cards": [
        {
          "id": "00-devanagari:conjunct:kssa",
          "devanagari": "क्ष",
          "gloss": "kṣa",
          "note": "conjunct · क + ष, and nothing of either shape survives — लक्ष्मीः, अक्षताः"
        },
        {
          "id": "00-devanagari:conjunct:jnya",
          "devanagari": "ज्ञ",
          "gloss": "jña",
          "note": "conjunct · ज + ञ, unreadable from its parts and said several ways aloud"
        },
        {
          "id": "00-devanagari:conjunct:tta",
          "devanagari": "त्त",
          "gloss": "tta",
          "note": "conjunct · त + त, stacked rather than joined side by side"
        },
        {
          "id": "00-devanagari:conjunct:kta",
          "devanagari": "क्त",
          "gloss": "kta",
          "note": "conjunct · क + त · the ending of hundreds of past participles"
        },
        {
          "id": "00-devanagari:conjunct:tra",
          "devanagari": "त्र",
          "gloss": "tra",
          "note": "conjunct · त + र · the र is the stroke underneath — त्रिशूलम् opens with it"
        },
        {
          "id": "00-devanagari:conjunct:shva",
          "devanagari": "श्व",
          "gloss": "śva",
          "note": "conjunct · श + व · श takes a shape of its own — महेश्वरः carries it"
        },
        {
          "id": "00-devanagari:conjunct:shca",
          "devanagari": "श्च",
          "gloss": "śca",
          "note": "conjunct · श + च"
        },
        {
          "id": "00-devanagari:conjunct:shra",
          "devanagari": "श्र",
          "gloss": "śra",
          "note": "conjunct · श + र"
        }
      ]
    },
