          "id": "00-devanagari:glyph:ba",
          "devanagari": "ब",
          "gloss": "ba",
          "note": "consonant · the p row · easily taken for व"
        },
        {
          "id": "00-devanagari:glyph:bha",
          "devanagari": "भ",
          "gloss": "bha",
          "note": "consonant · the p row · easily taken for म"
        },
        {
          "id": "00-devanagari:glyph:ma",
          "devanagari": "म",
          "gloss": "ma",
          "note": "consonant · the p row’s nasal"
