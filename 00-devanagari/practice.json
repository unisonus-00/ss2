{
  "lesson": "00-devanagari",
  "decks": [
    {
      "name": "Svara-varṇa — written alone",
      "role": "core",
      "stream": "script",
      "pair": "glyph → sound",
      "cards": [
        {
          "id": "00-devanagari:glyph:a",
          "devanagari": "अ",
          "gloss": "a",
          "note": "vowel letter · a vowel is written like this only where no consonant carries it — in practice, at the start of a word"
        },
        {
          "id": "00-devanagari:glyph:aa",
          "devanagari": "आ",
          "gloss": "ā",
          "note": "vowel letter · अ with a bar added on the right"
        },
        {
          "id": "00-devanagari:glyph:i",
          "devanagari": "इ",
          "gloss": "i",
          "note": "vowel letter"
        },
        {
          "id": "00-devanagari:glyph:ii",
          "devanagari": "ई",
          "gloss": "ī",
          "note": "vowel letter · the long counterpart of इ"
        },
        {
          "id": "00-devanagari:glyph:u",
          "devanagari": "उ",
          "gloss": "u",
          "note": "vowel letter · easily taken for ज"
        },
        {
          "id": "00-devanagari:glyph:uu",
          "devanagari": "ऊ",
          "gloss": "ū",
          "note": "vowel letter · the long counterpart of उ"
        },
        {
          "id": "00-devanagari:glyph:r-vowel",
          "devanagari": "ऋ",
          "gloss": "ṛ",
          "note": "vowel letter · a vowel in its own right, and the first sound of ऋषिः"
        },
        {
          "id": "00-devanagari:glyph:rr-vowel",
          "devanagari": "ॠ",
          "gloss": "ṝ",
          "note": "vowel letter · the long ऋ, and rare on the page"
        },
        {
          "id": "00-devanagari:glyph:l-vowel",
          "devanagari": "ऌ",
          "gloss": "ḷ",
          "note": "vowel letter · rarer still — it turns up in one root, kḷp"
        },
        {
          "id": "00-devanagari:glyph:e",
          "devanagari": "ए",
          "gloss": "e",
          "note": "vowel letter · always long in Sanskrit; there is no short e"
        },
        {
          "id": "00-devanagari:glyph:ai",
          "devanagari": "ऐ",
          "gloss": "ai",
          "note": "vowel letter · ए with a second stroke above"
        },
        {
          "id": "00-devanagari:glyph:o",
          "devanagari": "ओ",
          "gloss": "o",
          "note": "vowel letter · always long; there is no short o"
        },
        {
          "id": "00-devanagari:glyph:au",
          "devanagari": "औ",
          "gloss": "au",
          "note": "vowel letter · ओ with a second stroke above"
        }
      ]
    },
    {
      "name": "Sparśa I — throat, palate and dome",
      "role": "core",
      "stream": "script",
      "pair": "glyph → sound",
      "cards": [
        {
          "id": "00-devanagari:glyph:ka",
          "devanagari": "क",
          "gloss": "ka",
          "note": "consonant · the k row · a consonant letter is read with a built-in a — क on its own is ka, never bare k"
        },
        {
          "id": "00-devanagari:glyph:kha",
          "devanagari": "ख",
          "gloss": "kha",
          "note": "consonant · the k row · easily taken for the two letters रव"
        },
        {
          "id": "00-devanagari:glyph:ga",
          "devanagari": "ग",
          "gloss": "ga",
          "note": "consonant · the k row"
        },
        {
          "id": "00-devanagari:glyph:gha",
          "devanagari": "घ",
          "gloss": "gha",
          "note": "consonant · the k row · easily taken for ध"
        },
        {
          "id": "00-devanagari:glyph:nga",
          "devanagari": "ङ",
          "gloss": "ṅa",
          "note": "consonant · the k row’s nasal · almost only ever seen inside a conjunct, as in अङ्कुशः"
        },
        {
          "id": "00-devanagari:glyph:ca",
          "devanagari": "च",
          "gloss": "ca",
          "note": "consonant · the c row"
        },
        {
          "id": "00-devanagari:glyph:cha",
          "devanagari": "छ",
          "gloss": "cha",
          "note": "consonant · the c row"
        },
        {
          "id": "00-devanagari:glyph:ja",
          "devanagari": "ज",
          "gloss": "ja",
          "note": "consonant · the c row · easily taken for उ"
        },
        {
          "id": "00-devanagari:glyph:jha",
          "devanagari": "झ",
          "gloss": "jha",
          "note": "consonant · the c row"
        },
        {
          "id": "00-devanagari:glyph:nya",
          "devanagari": "ञ",
          "gloss": "ña",
          "note": "consonant · the c row’s nasal · seen almost only inside ज्ञ"
        },
        {
          "id": "00-devanagari:glyph:tta",
          "devanagari": "ट",
          "gloss": "ṭa",
          "note": "consonant · the ṭ row"
        },
        {
          "id": "00-devanagari:glyph:ttha",
          "devanagari": "ठ",
          "gloss": "ṭha",
          "note": "consonant · the ṭ row"
        },
        {
          "id": "00-devanagari:glyph:dda",
          "devanagari": "ड",
          "gloss": "ḍa",
          "note": "consonant · the ṭ row · easily taken for ङ"
        },
        {
          "id": "00-devanagari:glyph:ddha",
          "devanagari": "ढ",
          "gloss": "ḍha",
          "note": "consonant · the ṭ row"
        },
        {
          "id": "00-devanagari:glyph:nna",
          "devanagari": "ण",
          "gloss": "ṇa",
          "note": "consonant · the ṭ row’s nasal · common in ordinary words — कृष्णः, गणेशः"
        }
      ]
    },
    {
      "name": "Sparśa II — teeth and lips",
