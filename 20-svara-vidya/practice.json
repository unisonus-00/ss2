{
  "lesson": "20-svara-vidya",
  "overview": {
    "lead": "Vedic recitation carries pitch as well as sound. Three accents, marked in the text, distinguish Vedic from classical Sanskrit and change what a line means.",
    "plan": [
      "One list: Svara, giving the three accents, the recitation modes and the terms that describe them."
    ],
    "note": "Classical Sanskrit — everything else in Abhyāsa — does not use these accents. This stage is a door into a different kind of text, not a prerequisite for the others.",
    "mentions": [
      "Svara"
    ],
    "lists": 1
  },
